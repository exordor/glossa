# LLM 服务商密钥。复制为 .env.local（已被 .gitignore 忽略）后填写；永远不要提交真实密钥。
# 也可以在设置页里保存（存进系统钥匙串或 ~/.reader/credentials.json）。
# Vercel AI Gateway（默认 provider）：https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# DeepSeek 官方 API：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI 兼容服务（OpenAI、OpenRouter…；Ollama 不需要）。
OPENAI_COMPATIBLE_API_KEY=
