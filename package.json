{
  "name": "reader-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @reader/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "tokens": "pnpm --filter @reader/theme build",
    "obsidian:fixture": "tsx scripts/obsidian-roundtrip.ts make",
    "obsidian:check": "tsx scripts/obsidian-roundtrip.ts check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@reader/core": "workspace:*"
  }
}
